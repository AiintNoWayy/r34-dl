{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "r34-dl",
  "version": "0.4.1",
  "identifier": "com.aiintnowayy.r34dl",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "r34-dl",
        "width": 1000,
        "height": 1200,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AiintNoWayy/r34-dl/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEQkQ5OTQ4NzI0MEM4NTkKUldSWnlFQnlTSm05dmNZenlDY3VmM3RZcVhCaVNncnQ0eXgxbitPZGF1bUVKMk9NNkhDOFpFTlQK"
    }
  }
}
